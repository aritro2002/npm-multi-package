{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@aritro2002/addition": [
        "./packages/@aritro2002/addition/src/index.ts"
      ],
      "@aritro2002/subtraction": [
        "./packages/@aritro2002/subtraction/src/index.ts"
      ],
      "@aritro2002/multiplication": [
        "./packages/@aritro2002/multiplication/src/index.ts"
      ],
      "@aritro2002/regex": [
        "./packages/@aritro2002/regex/src/index.ts"
      ],
      "@aritro2002/calculator": [
        "./packages/@aritro2002/calculator/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/@aritro2002/*/src/**/*",
    "example/src/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/lib"
  ]
}
